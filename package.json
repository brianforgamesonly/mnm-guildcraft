{
  "name": "mnm-guildcraft",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p scripts",
    "test": "vitest run",
    "dev": "wrangler dev --env dev",
    "db:migrate:local": "wrangler d1 migrations apply mnm-guildcraft-dev --local --env dev",
    "import:local": "node scripts/import/run.ts --local",
    "import:remote": "node scripts/import/run.ts --remote",
    "commands:register": "node scripts/discord/register.ts"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "~4.1",
    "wrangler": "^4.151.2"
  }
}
