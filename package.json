{
  "name": "mnm-guildcraft",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:hook": "node --test .claude/hooks/check-bash.test.mjs",
    "test:actions": "node --test scripts/ci/action-runtimes.test.mjs",
    "test:commit-claims": "node --test scripts/ci/commit-claims.test.mjs",
    "test:logs": "node --test scripts/bench/logs-check.test.mjs",
    "test:backup": "node --test scripts/backup/lib.test.ts",
    "test:export": "node --test scripts/export/lib.test.ts",
    "test:routes": "node --test scripts/ci/routes.test.ts",
    "test:dkp-register": "node --test scripts/discord/dkp.test.ts",
    "bench:dkp-reads": "node scripts/bench/dkp-reads.ts",
    "test:operator-text": "node --test scripts/ci/operator-text.test.ts",
    "test:zone-sites": "node --test scripts/ci/zone-sites.test.ts",
    "test:health": "node --test scripts/health/judge.test.ts scripts/health/workers.test.ts scripts/usage/worker-cpu.test.ts",
    "test:ci-reads": "node --test scripts/ci/ci-reads.test.ts",
    "test:emoji": "node scripts/emoji/build.ts --check",
    "test:wiki": "node --test scripts/wiki/wiki.test.ts scripts/wiki/cleanup.test.ts scripts/wiki/level-text.test.ts",
    "dev": "wrangler dev --env dev",
    "db:migrate:local": "wrangler d1 migrations apply mnm-guildcraft-dev --local --env dev",
    "import:local": "node scripts/import/run.ts --local",
    "import:remote": "node scripts/import/run.ts --remote",
    "bench:import-writes": "node scripts/bench/import-writes.ts",
    "bench:gear-search": "node scripts/bench/gear-search.mjs",
    "bench:gear-upgrades": "node scripts/bench/gear-upgrades.mjs",
    "bench:gear-sources": "node scripts/bench/gear-sources.ts",
    "quest-sites": "node scripts/gear/quest-sites.ts",
    "test:quest-sites": "node --test scripts/gear/quest-sites.test.ts",
    "bench:cold-slot-list": "node scripts/bench/cold-slot-list.mjs",
    "bench:item-cards": "node scripts/bench/item-cards.ts",
    "bench:upgrade-pages": "node scripts/bench/upgrade-pages.mjs",
    "commands:register": "node scripts/discord/register.ts"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "~4.1",
    "wrangler": "^4.151.2"
  }
}
